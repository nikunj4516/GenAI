# Copy this file to ".env" and fill in your values.
# The ".env" file is ignored by Git, so your keys are never uploaded.

# Which LLM provider to use:  openai  (needs a key)   or   ollama  (free, runs on your computer)
LLM_PROVIDER=openai

# ---- OpenAI ----
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_CHAT_MODEL=gpt-6-luna
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_TEMPERATURE=            (empty = not sent; some newer models reject a custom temperature)

# ---- Ollama (used when LLM_PROVIDER=ollama): run `ollama pull llama3` and `ollama pull nomic-embed-text` ----
# OLLAMA_MODEL=llama3
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434
