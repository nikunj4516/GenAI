# Copy this file to ".env" and fill in your values.
# The ".env" file is ignored by Git, so your keys are never uploaded.

# ---- LangSmith (tracking) -------------------------------------------------
# Create a free account at https://smith.langchain.com  ->  Settings -> API Keys -> Create API Key
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=genai-assignment-24-ollama-chatbot
# EU accounts use:  LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- Ollama (local model, no API key needed) -------------------------------
# OLLAMA_MODEL=llama3                      (any model you pulled: llama3, mistral, llama3.2, ...)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_TEMPERATURE=0.7
