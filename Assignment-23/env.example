# Copy this file to ".env" and put your real key after the equals sign.
# The ".env" file is ignored by Git, so your key is never uploaded.

OPENAI_API_KEY=your-openai-api-key-here

# Optional overrides (defaults are shown):
# OPENAI_CHAT_MODEL=gpt-6-luna
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_TEMPERATURE=            (empty = not sent; some newer models reject a custom temperature)
# YOUTUBE_URL=https://www.youtube.com/watch?v=aircAruvnKk
