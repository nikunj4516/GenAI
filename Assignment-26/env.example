# Copy this file to ".env" and fill in your key. NEVER commit .env.
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides (defaults shown)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
CHAT_MODE=rag
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
TOP_K=5
LOG_LEVEL=INFO
